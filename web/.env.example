# web/.env.local 로 복사해서 값을 채운다. .env.local은 커밋하지 않는다 (.gitignore).
# 이 파일에는 이름만 적고 실제 값은 넣지 않는다.

# 실제 FastAPI 서버 주소 (예: http://localhost:8000). 비우면 개발 중(npm run dev)에는 목업으로 동작
NEXT_PUBLIC_API_BASE_URL=

# 1이면 목업(가짜 응답)으로 동작 (배포 빌드에서 목업을 쓸 때만)
NEXT_PUBLIC_USE_MOCK=

# Supabase 익명 로그인 (목록 19번). 프로젝트 설정 > API Keys
# 공개(publishable) 키만 넣는다. service_role·secret 키는 절대 넣지 않는다 (브라우저에 그대로 나감)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
