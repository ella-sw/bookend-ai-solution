# Copy to .env and fill in. Never commit .env.

# Supabase > Project Settings > Database > Connection string (Session pooler, port 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Supabase project URL. Used to fetch the public keys (JWKS) that sign user tokens.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Only for projects that still use the legacy shared JWT secret (HS256).
# Leave empty to verify tokens with the project's JWKS instead.
SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API (the Next.js app).
CORS_ORIGINS=http://localhost:3000

# Only for scripts/dev_token.py (testing by hand). The browser key, never service_role.
SUPABASE_PUBLISHABLE_KEY=

# --- AI (C) ---------------------------------------------------------------
# "openai" = real AI (OpenAI-compatible API). "stub" = fixed samples, no external calls (tests, local).
AI_PROVIDER=stub

# Logic model: daily questions, follow-up questions, material extraction, writing suggestions.
LOGIC_LLM_MODEL=
LOGIC_BASE_URL=
LOGIC_API_KEY=

# Essay model: AI draft and regenerate.
ESSAY_LLM_MODEL=
ESSAY_BASE_URL=
ESSAY_API_KEY=

# Fallbacks used only when the LOGIC_/ESSAY_ values above are empty.
# LLM_MODEL=
# LLM_BASE_URL=
# ELICE_API_KEY=
# OPENAI_API_KEY=

# --- AI usage limits --------------------------------------------------------
# AI calls per user per day (KST).
AI_DAILY_LIMIT=50
# Demo accounts: Supabase User UIDs, comma-separated, with their own daily limit.
DEMO_USER_IDS=
AI_DAILY_LIMIT_DEMO=500
